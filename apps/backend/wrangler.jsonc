{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cycle",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cycle",
      "database_id": "758574ec-7a67-4feb-94f9-406bfa7f0547",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "NODE_ENV": "production",
    "FRONTEND_URL": "https://cycle.alexintosh.com",
    "EMAIL_FROM": "cycle@alexintosh.com",
    "EMAIL_AUTH_ENABLED": "false"
  },
  "account_id": "f2818a0ebac168560030400aaf495a4b",
  "routes": [
    {
      "pattern": "cycle.alexintosh.com",
      "custom_domain": true
    }
  ]
}
